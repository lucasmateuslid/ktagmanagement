{
  "name": "ktag-manager",
  "private": true,
  "version": "5.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:backend & npm run dev:web",
    "dev:web": "npm run dev --workspace=@ktag/web",
    "dev:backend": "npm run dev --workspace=@ktag/backend",
    "build": "npm run build --workspace=@ktag/web",
    "typecheck": "npm run typecheck --workspace=@ktag/web && npm run typecheck --workspace=@ktag/backend",
    "lint": "npm run lint --workspace=@ktag/web",
    "lint:fix": "npm run lint:fix --workspace=@ktag/web",
    "docker:build": "docker build -f packages/backend/Dockerfile -t ktag-backend:local packages/backend"
  },
  "devDependencies": {
    "graphemer": "^1.4.0",
    "typescript": "^5.2.2"
  },
  "overrides": {
    "undici": "^6.25.0",
    "http-proxy-agent": "^7.0.2",
    "@tootallnate/once": "^3.0.1"
  }
}

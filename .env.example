GEOCODING_GOOGLE_API_KEY=
GEOCODING_USER_AGENT=

# Firebase web config
# Em produção (ktagfinder.app) → apontar para o projeto 'ktagfinder-prod'.
# Em sandbox/dev → 'saastagmanager'. No CI/CD essas vars são injetadas como
# build args no docker build (Vite faz inline no bundle).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Multi-tenant (dev)
# Tenant resolvido em dev quando o hostname é localhost/127.0.0.1.
# Pode ser sobrescrito por ?tenant=xxx na URL.
#
# Subdomínios reservados (não podem ser usados por tenants reais):
#   admin api www mail ftp static cdn auth app system root localhost lock
# - 'admin'  → painel super-admin (mesma app)
# - 'lock'   → reservado para instância externa (DNS desvia, app bloqueia se chegar)
# - apex (ktagfinder.app sem subdomínio) → placeholder/landing
VITE_DEV_TENANT=dev-tenant

# Para o seed script (scripts/seed-tenants.ts) — opcional se GOOGLE_APPLICATION_CREDENTIALS já estiver setado.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
SEED_ADMIN_PASSWORD=

# Origin secret compartilhado entre Cloudflare (Transform Rule injeta este
# header em todas as requests proxied) e o backend Cloud Run (valida e
# retorna 403 se faltar). Gere com: openssl rand -hex 32
# Setar idêntico nos dois lados. Só é validado em NODE_ENV=production.
CF_ORIGIN_SECRET=
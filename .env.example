# ─────────────────────────────────────────
# K-Tag Manager Pro — Stack Environment
# Copie este arquivo para .env e ajuste os valores
# ─────────────────────────────────────────

# PostgreSQL
POSTGRES_USER=ktag
POSTGRES_PASSWORD=TROQUE_ESTA_SENHA
POSTGRES_DB=ktagmanagement

# Redis
REDIS_PASSWORD=TROQUE_ESTA_SENHA_REDIS

# Traccar
TRACCAR_URL=http://traccar:8082
TRACCAR_USER=admin
TRACCAR_PASS=TROQUE_ESTA_SENHA_TRACCAR

# Backend
BACKEND_PORT=8080
ALLOWED_ORIGINS=http://localhost:3000
API_BEARER_TOKEN=TROQUE_ESTE_TOKEN_FORTE
SESSION_TOKEN_SECRET=TROQUE_ESTE_SECRET_FORTE
AUTH_PASSWORD_PEPPER=KTAG_SECURE_SALT_V3_2025
ADMIN_EMAIL=seu@email.com

# Integrações externas (opcional)
K_TAG_API_URL=
K_TAG_API_USER=
K_TAG_API_PASS=
XADTAG_API_TOKEN=
GOOGLE_MAPS_SERVER_KEY=
HINOVA_TOKEN=
HINOVA_USER=
HINOVA_PASS=

# Frontend
VITE_BACKEND_API_URL=http://localhost:8080
API_KEY=SUA_CHAVE_GEMINI_AQUI

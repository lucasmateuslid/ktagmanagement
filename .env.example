# K-Tag Manager — variáveis de ambiente
# Copie para .env e preencha os valores antes de usar o Docker Compose.
# NUNCA commite o arquivo .env real.

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=troque_por_senha_forte_aqui

# ─── Traccar 6.14.5 (somente backend / Secret Manager em produção) ───────────
TRACCAR_API_URL=http://localhost:8082/api
TRACCAR_WEB_URL=http://localhost:8082
TRACCAR_WS_URL=ws://localhost:8082/api/socket
TRACCAR_API_TOKEN=
TRACCAR_EMAIL=
TRACCAR_PASSWORD=
TRACCAR_REQUEST_TIMEOUT_MS=10000
TRACCAR_GT06_PORT=5023
TRACCAR_PLATFORM_SOURCE=KTagFinder
TRACCAR_WS_RECONNECT_MIN_MS=1000
TRACCAR_WS_RECONNECT_MAX_MS=30000
TRACCAR_REST_FALLBACK_INTERVAL_MS=30000
TRACCAR_ADDRESS_CACHE_TTL_MS=300000
TRACCAR_POSITION_CACHE_TTL_MS=15000
TRACCAR_POSITION_PERSIST_INTERVAL_MS=300000
TRACCAR_WRITE_TEST_ENABLED=false
TRACCAR_REALTIME_ENABLED=true

# Histórico unificado (backend)
HISTORY_MAX_RANGE_DAYS=30
HISTORY_PAGE_SIZE_DEFAULT=500
HISTORY_POINT_LIMIT_MAX=1500
HISTORY_RATE_LIMIT_PER_MINUTE=20

# ─── Integração Backend ↔ Traccar (Fase 4) ────────────────────────────────────
# Secret compartilhado entre Traccar e K-Tag Backend para webhooks internos
INTERNAL_SECRET=gere_com_openssl_rand_hex_32

# Polling de posições em dev (ms) — alternativa ao webhook quando backend está no host
# Ex: TRACCAR_POLL_INTERVAL=5000 para atualizar WebSocket a cada 5s
TRACCAR_POLL_INTERVAL=0

# URL do backend acessível pelo Traccar (Docker full profile)
# Ex: BACKEND_URL=http://backend:4000
BACKEND_URL=

# ─── K-Tag Backend ────────────────────────────────────────────────────────────
PORT=4000
VITE_DEV_BACKEND_URL=http://localhost:4001
NODE_ENV=development

# Cloudflare origin secret (produção)
CF_ORIGIN_SECRET=

# Proxy allowlist (hosts externos permitidos no /api/proxy)
PROXY_ALLOWED_HOSTS=

# Melhor Envio webhook
MELHOR_ENVIO_WEBHOOK_SECRET=

# ─── Firebase ─────────────────────────────────────────────────────────────────
# Backend/worker na VPS. Use uma service account com acesso somente ao projeto.
# O JSON deve ficar em uma única linha no .env e nunca deve usar prefixo VITE_.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Coleta K-TAG executada pelo worker da VPS
KTAG_API_URL=
KTAG_API_USER=
KTAG_API_PASS=
VITE_TRACKING_API_URL=
KTAG_POLL_INTERVAL_MS=1800000
KTAG_REQUEST_TIMEOUT_MS=30000
KTAG_BATCH_SIZE=50
KTAG_HISTORY_RETENTION_DAYS=30
# (usados pelo frontend em dev — injetados via VITE_* no build de produção)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

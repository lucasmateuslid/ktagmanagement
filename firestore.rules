rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // K-Tag Manager Pro — Firestore Rules (Multi-tenant Fase 2)
    // ============================================================
    //
    // Modelo:
    //   /tenants/{tenantId}                       — metadata do tenant
    //   /tenants/{tenantId}/users/{uid}           — usuários do tenant
    //   /tenants/{tenantId}/<entity>/{id}         — qualquer entidade de domínio
    //   /system_admins/{uid}                      — superadmins da plataforma
    //
    // Autenticação: Firebase Auth (Fase 2). request.auth.uid é o uid do user doc.
    // request.auth.token.tenantId é setado por Cloud Function onTenantUserCreate.
    //
    // Estratégia: as rules permitem fast-path via custom claims (token.tenantId)
    // e fallback para exists() do doc. Custom claims podem demorar um ciclo de
    // refresh para propagar após criação — o fallback evita race condition no
    // primeiro login.

    // ---------- HELPERS ----------

    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      // Fast-path via custom claim (setada por addSystemAdmin callable).
      // Fallback via lookup do doc — útil enquanto a claim não propagou.
      return isAuthenticated()
        && (request.auth.token.superadmin == true
            || exists(/databases/$(database)/documents/system_admins/$(request.auth.uid)));
    }

    // Fast-path via custom claim setada por onTenantUserCreate/Update.
    function hasTenantClaim(tenantId) {
      return isAuthenticated()
        && request.auth.token.tenantId == tenantId
        && request.auth.token.approved == true;
    }

    // Fallback (custa 1 read) — útil enquanto a claim não propagou no token atual.
    function hasTenantDoc(tenantId) {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/tenants/$(tenantId)/users/$(request.auth.uid));
    }

    function isMemberOf(tenantId) {
      return hasTenantClaim(tenantId) || hasTenantDoc(tenantId);
    }

    function memberData(tenantId) {
      return get(/databases/$(database)/documents/tenants/$(tenantId)/users/$(request.auth.uid)).data;
    }

    function isTenantAdmin(tenantId) {
      // Fast-path via claim
      return (hasTenantClaim(tenantId)
              && (request.auth.token.role == 'admin'
                  || request.auth.token.role == 'admin_tecnico'))
          // Fallback via doc
          || (hasTenantDoc(tenantId)
              && (memberData(tenantId).role == 'admin'
                  || memberData(tenantId).role == 'admin_tecnico'));
    }

    function isTenantModerator(tenantId) {
      return (hasTenantClaim(tenantId)
              && (request.auth.token.role == 'admin'
                  || request.auth.token.role == 'admin_tecnico'
                  || request.auth.token.role == 'moderator'))
          || (hasTenantDoc(tenantId)
              && (memberData(tenantId).role == 'admin'
                  || memberData(tenantId).role == 'admin_tecnico'
                  || memberData(tenantId).role == 'moderator'));
    }

    // ---------- TENANT ROOT ----------
    //
    // NOTA DE SEGURANÇA (OWASP A01 — Broken Access Control):
    // Em Firestore Rules, múltiplas `match` que casam no mesmo path são
    // combinadas com OR — não há "regra mais específica vence". Por isso o
    // catch-all `match /tenants/{tenantId}/{document=**}` foi REMOVIDO daqui;
    // ele tornaria as regras restritivas de invoices/audit_logs/etc dead code.
    // Cada subcoleção é declarada explicitamente. Coleções novas começam
    // negadas por padrão — adicione um `match` específico antes de gravar.

    match /tenants/{tenantId} {
      allow read: if isMemberOf(tenantId) || isSuperAdmin();
      allow create, update, delete: if isSuperAdmin();
    }

    // ---------- REGRAS ESPECÍFICAS POR COLEÇÃO ----------

    // Usuários: dono lê/atualiza o próprio; admin do tenant controla os demais.
    // Pendentes (status != approved) só podem ser lidos por admins — evita que
    // um usuário "esperando aprovação" descubra outros usuários pendentes.
    match /tenants/{tenantId}/users/{userId} {
      allow read: if (hasTenantDoc(tenantId) && request.auth.uid == userId)
                     || isTenantModerator(tenantId)
                     || isSuperAdmin();

      // Registro novo: precisa ser o próprio uid + bater com o tenantId atual.
      // Status forçado a 'pending' previne self-promotion.
      allow create: if (request.auth != null && request.auth.uid == userId
                        && request.resource.data.tenantId == tenantId
                        && request.resource.data.status == 'pending'
                        && request.resource.data.role == 'user')
                       || isTenantAdmin(tenantId)
                       || isSuperAdmin();

      // Update: dono pode editar campos não-sensíveis; admin pode tudo.
      allow update: if (hasTenantDoc(tenantId) && request.auth.uid == userId
                        && request.resource.data.role == resource.data.role
                        && request.resource.data.status == resource.data.status
                        && request.resource.data.tenantId == resource.data.tenantId)
                       || isTenantAdmin(tenantId)
                       || isSuperAdmin();

      allow delete: if isTenantAdmin(tenantId) || isSuperAdmin();
    }

    // Settings (credenciais de terceiros do tenant): leitura para membros, write
    // só admin.
    match /tenants/{tenantId}/settings/{docId} {
      allow read: if isMemberOf(tenantId);
      allow write: if isTenantAdmin(tenantId) || isSuperAdmin();
    }

    // Faturas de mensalidade. Espelho do Asaas — escrita só via Admin SDK
    // (Cloud Functions ignoram regras). Leitura limitada a admin do tenant +
    // super admin para não vazar dados financeiros aos demais membros.
    match /tenants/{tenantId}/invoices/{invoiceId} {
      allow read: if isTenantAdmin(tenantId) || isSuperAdmin();
      allow write: if false;
    }

    // Audit logs: append-only para membros, leitura só admin. update/delete bloqueados.
    match /tenants/{tenantId}/audit_logs/{logId} {
      allow read: if isTenantAdmin(tenantId) || isSuperAdmin();
      allow create: if isMemberOf(tenantId);
      allow update, delete: if false;
    }

    // Custom roles: leitura para membros (usado em hasPermission), write só admin.
    match /tenants/{tenantId}/custom_roles/{roleId} {
      allow read: if isMemberOf(tenantId);
      allow write: if isTenantAdmin(tenantId) || isSuperAdmin();
    }

    // Stolen records: leitura via trackingToken na URL para terceiros (ex.: polícia)
    // mas o token DEVE ser secreto / impossível de listar. Write restrito a membros.
    //
    // OBS: leitura via trackingToken não pode ser feita por list/query pública —
    // o cliente já precisa saber o ID do doc para acessar. Em Firestore Rules
    // isso significa que list/query externa retorna PERMISSION_DENIED, mas get
    // de um doc específico funciona se o doc carrega trackingToken.
    match /tenants/{tenantId}/stolen_records/{recordId} {
      allow get: if isMemberOf(tenantId)
                    || isSuperAdmin()
                    || (resource != null && resource.data.trackingToken != null);
      allow list: if isMemberOf(tenantId) || isSuperAdmin();
      allow create: if isMemberOf(tenantId);
      allow update, delete: if isTenantAdmin(tenantId) || isSuperAdmin();
    }

    // ---------- COLEÇÕES DE DOMÍNIO (acesso livre p/ membros do tenant) ----------
    // Estas são as coleções operacionais — read/write para qualquer membro
    // aprovado é o comportamento esperado. Adicionar novas aqui quando criadas.

    match /tenants/{tenantId}/tags/{docId} {
      allow read, write: if isMemberOf(tenantId) || isSuperAdmin();
    }
    match /tenants/{tenantId}/trackers/{docId} {
      allow read, write: if isMemberOf(tenantId) || isSuperAdmin();
    }
    match /tenants/{tenantId}/vehicles/{vehicleId} {
      allow read, write: if isMemberOf(tenantId) || isSuperAdmin();
      match /history/{histId} {
        allow read, write: if isMemberOf(tenantId) || isSuperAdmin();
      }
    }
    match /tenants/{tenantId}/clients/{docId} {
      allow read, write: if isMemberOf(tenantId) || isSuperAdmin();
    }
    match /tenants/{tenantId}/companies/{docId} {
      allow read, write: if isMemberOf(tenantId) || isSuperAdmin();
    }
    match /tenants/{tenantId}/categories/{docId} {
      allow read, write: if isMemberOf(tenantId) || isSuperAdmin();
    }
    match /tenants/{tenantId}/schedules/{docId} {
      allow read, write: if isMemberOf(tenantId) || isSuperAdmin();
    }
    match /tenants/{tenantId}/technicians/{docId} {
      allow read, write: if isMemberOf(tenantId) || isSuperAdmin();
    }
    match /tenants/{tenantId}/technician_payments/{docId} {
      allow read: if isTenantModerator(tenantId) || isSuperAdmin();
      allow write: if isTenantAdmin(tenantId) || isSuperAdmin();
    }
    match /tenants/{tenantId}/feedbacks/{docId} {
      allow read, write: if isMemberOf(tenantId) || isSuperAdmin();
    }
    match /tenants/{tenantId}/system_updates/{docId} {
      allow read: if isMemberOf(tenantId) || isSuperAdmin();
      allow write: if isTenantAdmin(tenantId) || isSuperAdmin();
    }
    match /tenants/{tenantId}/shipments/{docId} {
      allow read, write: if isMemberOf(tenantId) || isSuperAdmin();
    }
    match /tenants/{tenantId}/shipping_addresses/{docId} {
      allow read, write: if isMemberOf(tenantId) || isSuperAdmin();
    }

    // ---------- SISTEMA (cross-tenant) ----------

    match /system_admins/{uid} {
      allow read: if isAuthenticated() && request.auth.uid == uid;
      allow write: if isSuperAdmin();
    }

    match /system_audit_logs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // Forensics de cada entrega do webhook Asaas. Escrita exclusiva pelo Admin SDK
    // (Cloud Functions ignoram regras). Leitura restrita a superadmin.
    match /system_billing_events/{eventId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // Config global da plataforma (whitelabel, anúncios). Leitura pública
    // para usuários autenticados; escrita restrita a superadmins.
    match /ktag_settings_v3/{docId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // Inventário global de rastreadores físicos (cross-tenant, usado em Envios).
    // Leitura: qualquer autenticado (catálogo compartilhado).
    // Escrita: somente super admin — evita que um tenant adultere o catálogo
    // global usado por outros tenants. (Issue OWASP A01 — Broken Access Control.)
    match /ktag_trackers/{docId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // Push subscriptions ficam flat (Functions varre cross-tenant para envio
    // global de notificações por preferência). Cada doc carrega userId.
    match /push_subscriptions/{subId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow update: if false;
    }
  }
}

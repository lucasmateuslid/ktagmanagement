
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- FUNÇÕES AUXILIARES ---

    // Verifica se o usuário está autenticado no Firebase Auth
    function isAuthenticated() {
      return request.auth != null;
    }

    // Busca os dados do usuário atual no banco de dados para checar a role
    // Nota: Isso custa 1 leitura de documento por requisição.
    function getUserData() {
      return get(/databases/$(database)/documents/ktag_users_db/$(request.auth.uid)).data;
    }

    // Verifica se o usuário possui uma role específica
    function hasRole(role) {
      return isAuthenticated() && getUserData().role == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isModerator() {
      return isAuthenticated() && (getUserData().role == 'moderator' || getUserData().role == 'admin');
    }

    // Verifica se o usuário é dono do documento (comparando IDs)
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Validação básica de dados para evitar lixo no banco
    function hasFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    // --- REGRAS DAS COLEÇÕES ---

    // 1. USUÁRIOS (ktag_users_db)
    // - Leitura: Dono ou Moderador+
    // - Criação: Apenas se o ID bater com o Auth (Registro) ou Admin criando outros
    // - Atualização: Dono (campos limitados) ou Admin
    match /ktag_users_db/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isModerator());
      allow create: if isAuthenticated() && (isOwner(userId) || isAdmin()) 
                    && hasFields(['email', 'role']);
      allow update: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow delete: if isAdmin();
    }

    // 2. VEÍCULOS (ktag_vehicles)
    // - Leitura: Qualquer usuário autenticado (Operação básica)
    // - Leitura Pública: Permitida se o veículo estiver marcado como ROUBADO (para rastreamento policial)
    // - Escrita: Apenas Moderadores ou Admins
    // - Validação: Deve ter placa e modelo
    match /ktag_vehicles/{vehicleId} {
      allow read: if isAuthenticated() || resource.data.status == 'stolen';
      allow create, update: if isModerator() && hasFields(['plate', 'model', 'status']);
      allow delete: if isModerator();
    }

    // 3. EQUIPAMENTOS / TAGS (ktag_tags)
    // - Leitura: Autenticado
    // - Escrita: Moderador+
    match /ktag_tags/{tagId} {
      allow read: if isAuthenticated();
      allow write: if isModerator();
    }

    // 4. CLIENTES (ktag_clients)
    // - Leitura: Autenticado
    // - Escrita: Moderador+
    match /ktag_clients/{clientId} {
      allow read: if isAuthenticated();
      allow write: if isModerator();
    }

    // 5. REGISTROS DE ROUBO (ktag_stolen_records)
    // - Leitura: Autenticado ou se possuir um trackingToken (Acesso Policial)
    // - Criação: Qualquer usuário autenticado (Reportar)
    // - Atualização/Delete: Apenas Admin (para evitar adulteração de histórico)
    match /ktag_stolen_records/{recordId} {
      allow read: if isAuthenticated() || (resource.data.trackingToken != null);
      allow create: if isAuthenticated() && hasFields(['vehicleId', 'type', 'timestamp']);
      allow update, delete: if isAdmin();
    }

    // 6. LOGS DE AUDITORIA (ktag_audit_logs)
    // - Leitura: Apenas Admin
    // - Criação: Qualquer autenticado (Sistema gera logs automaticamente)
    // - Atualização/Delete: NINGUÉM (Logs são imutáveis)
    match /ktag_audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false; 
    }

    // 7. CONFIGURAÇÕES (ktag_settings_v3)
    // - Leitura: Autenticado (O app precisa das chaves de API para funcionar)
    // - Escrita: ESTRITAMENTE ADMIN
    match /ktag_settings_v3/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 8. EMPRESAS E CATEGORIAS (Listas auxiliares)
    match /ktag_companies/{companyId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    match /ktag_categories/{categoryId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // 9. NOTIFICAÇÕES
    // Usuário só lê/escreve suas próprias notificações se implementado com ID
    // Como o sistema atual usa array global ou local, permitimos leitura geral
    match /ktag_notifications/{noteId} {
      allow read, write: if isAuthenticated();
    }
  }
}

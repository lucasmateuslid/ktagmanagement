# Copie para .env.vps neste diretório. Não versionar valores reais.
KTAG_IMAGE_TAG=latest
KTAG_BACKEND_PORT=4000
TRACCAR_DOCKER_NETWORK=traccar_default
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json

# Firebase público: incorporado ao bundle web no build.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_TRACKING_API_URL=https://api-vps.ktagfinder.app

# Traccar acessado pela rede Docker da VPS.
TRACCAR_API_URL=http://traccar:8082/api
TRACCAR_WEB_URL=https://traccar.ktagfinder.app
TRACCAR_WS_URL=ws://traccar:8082/api/socket
TRACCAR_API_TOKEN=
TRACCAR_EMAIL=
TRACCAR_PASSWORD=
TRACCAR_REQUEST_TIMEOUT_MS=10000
TRACCAR_GT06_PORT=5023
TRACCAR_PLATFORM_SOURCE=KTagFinder
TRACCAR_WS_RECONNECT_MIN_MS=1000
TRACCAR_WS_RECONNECT_MAX_MS=30000
TRACCAR_REST_FALLBACK_INTERVAL_MS=30000
TRACCAR_ADDRESS_CACHE_TTL_MS=300000
TRACCAR_POSITION_CACHE_TTL_MS=15000
# Atualiza o mapa em toda mensagem, mas persiste um checkpoint a cada 5 minutos.
TRACCAR_POSITION_PERSIST_INTERVAL_MS=300000
TRACCAR_WRITE_TEST_ENABLED=false
TRACCAR_REALTIME_ENABLED=true

# O mesmo valor deve ser injetado pelo Nginx na chamada local ao backend.
CF_ORIGIN_SECRET=
INTERNAL_SECRET=
PROXY_ALLOWED_HOSTS=
MELHOR_ENVIO_WEBHOOK_SECRET=
DEFAULT_DEV_TENANT=

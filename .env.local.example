# K-Tag Management - Environment Variables
# Copy this file to .env.local and fill with your actual values
# NEVER commit .env.local to version control

# JWT Secret Key (generate a strong random key)
# To generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
VITE_JWT_SECRET=your-super-secret-jwt-key-here-minimum-32-characters

# Firebase Configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# API Keys (Optional - for backend proxy)
# NEVER store these in client-side code
VITE_HINOVA_API_KEY=
VITE_TRAQCARE_API_KEY=

# Environment
VITE_ENV=development
